# Not loaded automatically: uncomment a line and export it in your shell (or CI) before running the tests.
# Test-only accounts on the local test server that playwright.config.ts starts.
# Leave unset to use the built-in throwaway defaults (see tests/admin.ts).
# Admin the server is seeded with (passed to it as ADMIN_PASSWORD).
# QA_PRACTICE_ADMIN_PASSWORD=your-test-admin-password
# Password for the customer accounts the tests register.
# QA_PRACTICE_PASSWORD=your-test-user-password
