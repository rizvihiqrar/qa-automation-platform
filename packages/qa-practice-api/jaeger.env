# npm run start:jaeger: the API sends its traces to the local Jaeger that
# `npm run jaeger` starts (Docker), to look at them on http://localhost:16686.
# Jaeger takes traces only, so metrics are off. Read by node --env-file.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_EXPORTER=none
OTEL_SERVICE_NAME=qa-practice-api
OTEL_BSP_SCHEDULE_DELAY=500
# The throwaway test admin from tests/admin.ts, so products can be added.
ADMIN_EMAIL=admin@qa-practice.test
ADMIN_PASSWORD=Admin-only-in-tests-1!
