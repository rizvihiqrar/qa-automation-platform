{
  "name": "qa-practice-api",
  "version": "1.0.0",
  "description": "A purpose-built REST API for QA automation practice — auth, CRUD, pagination, stock management, and documented edge cases",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test",
    "test:properties": "node --test \"tests/properties/*.property.ts\"",
    "test:mutation": "stryker run",
    "scoreboard": "node scoreboard/run.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "fast-check": "^4.10.2"
  }
}
