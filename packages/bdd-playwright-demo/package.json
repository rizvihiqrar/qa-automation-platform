{
  "name": "bdd-playwright-demo",
  "version": "1.0.0",
  "type": "module",
  "description": "Playwright + Cucumber BDD demo — Gherkin feature files executed against saucedemo.com",
  "scripts": {
    "test": "cucumber-js",
    "test:guard": "node --test \"test/*.test.ts\"",
    "smoke": "node scripts/require-scenarios.ts @smoke && cucumber-js --tags @smoke",
    "regression": "node scripts/require-scenarios.ts @regression && cucumber-js --tags @regression"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.5",
    "playwright": "^1.49.0"
  }
}
