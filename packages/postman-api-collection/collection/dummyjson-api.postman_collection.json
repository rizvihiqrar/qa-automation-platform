{
  "info": {
    "name": "DummyJSON API",
    "description": "REST API tests for the public DummyJSON demo API — covers CRUD, auth, token lifecycle, schema validation, and error handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://dummyjson.com" },
    { "key": "userId",  "value": "1" },
    { "key": "authToken", "value": "" }
  ],
  "item": [
    {
      "name": "Smoke",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users?limit=10&skip=0",
            "header": [{ "key": "Accept", "value": "application/json" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has users array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.users).to.be.an('array').and.not.empty;",
                  "});",
                  "pm.test('Response has pagination fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.all.keys('users', 'total', 'skip', 'limit');",
                  "});",
                  "pm.test('Response time under 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Single User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [{ "key": "Accept", "value": "application/json" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('User has correct schema', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id').that.is.a('number');",
                  "  pm.expect(body).to.have.property('firstName').that.is.a('string');",
                  "  pm.expect(body).to.have.property('lastName').that.is.a('string');",
                  "  pm.expect(body).to.have.property('email').that.includes('@');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/add",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"age\": 30\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response contains new user id', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id').that.is.a('number');",
                  "  pm.expect(body.firstName).to.eql('Test');",
                  "  pm.expect(body.lastName).to.eql('User');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Valid",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"emilyspass\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response contains access and refresh tokens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('authToken', body.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User (token auth)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Accept",        "value": "application/json" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns authenticated user', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.username).to.eql('emilys');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Regression",
      "item": [
        {
          "name": "List Users - Skip",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users?limit=5&skip=5",
            "header": [{ "key": "Accept", "value": "application/json" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Skip field equals 5', () => {",
                  "  pm.expect(pm.response.json().skip).to.eql(5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User - Not Found",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/9999",
            "header": [{ "key": "Accept", "value": "application/json" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Response has message field', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('message');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update User (PUT)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"age\": 31\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Age field is updated', () => {",
                  "  pm.expect(pm.response.json().age).to.eql(31);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update User (PATCH)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 99\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Age field is patched', () => {",
                  "  pm.expect(pm.response.json().age).to.eql(99);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [{ "key": "Accept", "value": "application/json" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('isDeleted flag is true', () => {",
                  "  pm.expect(pm.response.json().isDeleted).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Wrong Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"wrongpassword\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error message present', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('message');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User - No Token",
          "protocolProfileBehavior": { "disableCookies": true },
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [{ "key": "Accept", "value": "application/json" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 without token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
