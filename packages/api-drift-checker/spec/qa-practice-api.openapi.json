{
  "openapi": "3.0.3",
  "info": {
    "title": "qa-practice-api",
    "version": "1.0.0",
    "description": "Contract for packages/qa-practice-api, written from its routes. The drift checker compares live responses against it."
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": { "description": "Service is up", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }
        }
      }
    },
    "/auth/register": {
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name","email","password"], "properties": {"name":{"type":"string"},"email":{"type":"string"},"password":{"type":"string"}} }, "example": {"name":"ZAP Scan","email":"zap-scan@example.com","password":"Zap-scan-pass-1!"} } } },
        "responses": {
          "201": { "description": "Registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResult" } } } },
          "400": { "description": "Missing fields", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Email in use", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/auth/login": {
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["email","password"], "properties": {"email":{"type":"string"},"password":{"type":"string"}} }, "example": {"email":"zap-scan@example.com","password":"Zap-scan-pass-1!"} } } },
        "responses": {
          "200": { "description": "Logged in", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResult" } } } },
          "400": { "description": "Missing fields", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Wrong credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "description": "Too many sign-in attempts (see the Retry-After header)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/auth/me": {
      "get": {
        "responses": {
          "200": { "description": "Current user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "401": { "description": "No or bad token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/users": {
      "get": {
        "responses": {
          "200": { "description": "Page of users", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserPage" } } } },
          "401": { "description": "No or bad token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Not an admin", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/users/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }],
      "get": {
        "responses": {
          "200": { "description": "A user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "403": { "description": "Another user's account, and the caller isn't an admin", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/products": {
      "get": {
        "responses": {
          "200": { "description": "Page of products", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductPage" } } } }
        }
      },
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name","category","price"], "properties": {"name":{"type":"string"},"category":{"type":"string"},"price":{"type":"number","minimum":0,"description":"Whole cents: at most two decimals"},"stock":{"type":"integer","minimum":0}} }, "example": {"name":"Backpack","category":"bags","price":29.99,"stock":10} } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
          "400": { "description": "Missing or invalid fields", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "No or bad token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Not an admin", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/products/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }],
      "get": {
        "responses": {
          "200": { "description": "A product", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/orders": {
      "get": {
        "responses": {
          "200": { "description": "The caller's orders (an admin's: every order), newest first", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } } } } }
        }
      },
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["items"], "properties": {"items":{"type":"array","minItems":1,"description":"The subtotal, price × quantity over all lines, may be at most 999999999.99; above that is a 400","items":{"type":"object","required":["product_id","quantity"],"properties":{"product_id":{"type":"integer"},"quantity":{"type":"integer","minimum":1}}}},"discount_code":{"type":"string","nullable":true,"minLength":1,"description":"Looked up after trimming, ignoring case; empty after trimming is a 400 (DC-R13)"}} }, "example": {"items":[{"product_id":1,"quantity":1}]} } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "400": { "description": "Invalid items, not enough stock, or a discount_code that is not a non-empty string", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Product not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "422": { "description": "Discount code refused: not valid, expired, used up, already used by this customer, or minimum not met", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/orders/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }],
      "get": {
        "responses": {
          "200": { "description": "An order", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "404": { "description": "Not found or not yours", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/orders/{id}/status": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 1 }],
      "patch": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": {"status":{"type":"string","enum":["pending","processing","shipped","delivered","cancelled"]}} }, "example": {"status":"processing"} } } },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "400": { "description": "Unknown status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "A customer asking for any status but cancelled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Not allowed from the current status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/discounts": {
      "get": {
        "responses": {
          "200": { "description": "Every discount code", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Discount" } } } } },
          "401": { "description": "No or bad token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Not an admin", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "post": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["code","type","value"], "properties": {"code":{"type":"string","pattern":"^\\s*[A-Za-z0-9-]{3,20}\\s*$"},"type":{"type":"string","enum":["percent","fixed"]},"value":{"type":"number","exclusiveMinimum":true,"minimum":0,"description":"percent: a whole number from 1 to 100. fixed: above 0, at most two decimals (DC-R04)"},"expires_at":{"type":"string","format":"date-time","nullable":true,"description":"A real date and time with a time zone, in the future (DC-R05)"},"max_uses":{"type":"integer","minimum":1,"nullable":true},"min_subtotal":{"type":"number","minimum":0,"description":"At most two decimals (DC-R07)"},"active":{"type":"boolean"}} }, "example": {"code":"SUMMER10","type":"percent","value":10} } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Discount" } } } },
          "400": { "description": "Missing or invalid fields", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "No or bad token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Not an admin", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "A code with the same letters, ignoring case, exists", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/discounts/{code}": {
      "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" }, "example": "SUMMER10" }],
      "get": {
        "responses": {
          "200": { "description": "A discount code", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Discount" } } } },
          "401": { "description": "No or bad token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Not an admin", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "patch": {
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "properties": {"active":{"type":"boolean"},"expires_at":{"type":"string","format":"date-time","nullable":true,"description":"A real date and time with a time zone, in the future (DC-R05)"},"max_uses":{"type":"integer","minimum":1,"nullable":true}} }, "example": {"active":false} } } },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Discount" } } } },
          "400": { "description": "Invalid or not changeable fields", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "No or bad token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "403": { "description": "Not an admin", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "max_uses below the uses already counted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object", "additionalProperties": false, "required": ["status", "timestamp"],
        "properties": { "status": { "type": "string", "enum": ["ok"] }, "timestamp": { "type": "string", "format": "date-time" } }
      },
      "Error": {
        "type": "object", "additionalProperties": false, "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "User": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "email", "role", "created_at"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["user", "admin"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "AuthResult": {
        "type": "object", "additionalProperties": false, "required": ["user", "token"],
        "properties": { "user": { "$ref": "#/components/schemas/User" }, "token": { "type": "string" } }
      },
      "Product": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "category", "price", "stock", "created_at"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "price": { "type": "number", "minimum": 0 },
          "stock": { "type": "integer", "minimum": 0 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "OrderItem": {
        "type": "object", "additionalProperties": false, "required": ["product_id", "name", "price", "quantity"],
        "properties": {
          "product_id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "price": { "type": "number", "minimum": 0 },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      },
      "Order": {
        "type": "object", "additionalProperties": false, "required": ["id", "user_id", "status", "subtotal", "discount_code", "discount", "total", "items", "created_at"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "user_id": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
          "subtotal": { "type": "number", "minimum": 0 },
          "discount_code": { "type": "string", "nullable": true },
          "discount": { "type": "number", "minimum": 0 },
          "total": { "type": "number", "minimum": 0 },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/OrderItem" } },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Discount": {
        "type": "object", "additionalProperties": false, "required": ["code", "type", "value", "expires_at", "max_uses", "min_subtotal", "active", "uses", "created_at"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9-]{3,20}$" },
          "type": { "type": "string", "enum": ["percent", "fixed"] },
          "value": { "type": "number" },
          "expires_at": { "type": "string", "format": "date-time", "nullable": true },
          "max_uses": { "type": "integer", "minimum": 1, "nullable": true },
          "min_subtotal": { "type": "number", "minimum": 0 },
          "active": { "type": "boolean" },
          "uses": { "type": "integer", "minimum": 0 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Page": {
        "type": "object", "required": ["data", "page", "limit", "total", "pages"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1 },
          "total": { "type": "integer", "minimum": 0 },
          "pages": { "type": "integer", "minimum": 1 }
        }
      },
      "UserPage": {
        "type": "object", "additionalProperties": false, "required": ["data", "page", "limit", "total", "pages"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/User" } },
          "page": { "type": "integer", "minimum": 1 }, "limit": { "type": "integer", "minimum": 1 },
          "total": { "type": "integer", "minimum": 0 }, "pages": { "type": "integer", "minimum": 1 }
        }
      },
      "ProductPage": {
        "type": "object", "additionalProperties": false, "required": ["data", "page", "limit", "total", "pages"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
          "page": { "type": "integer", "minimum": 1 }, "limit": { "type": "integer", "minimum": 1 },
          "total": { "type": "integer", "minimum": 0 }, "pages": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
