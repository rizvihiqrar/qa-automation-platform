# Headless initialization for the throwaway Langfuse in langfuse/docker-compose.yml:
# one organization, one project with these API keys, and one user, created at start.
# These values are public on purpose. They only work against a Langfuse started from
# this file on your own machine or a CI runner; never reuse them anywhere else.
# (No quotes around values: Langfuse's docs say compose passes them through literally.)
LANGFUSE_INIT_ORG_ID=llm-judge-check
LANGFUSE_INIT_ORG_NAME=llm-judge-check
LANGFUSE_INIT_PROJECT_ID=llm-judge-check
LANGFUSE_INIT_PROJECT_NAME=llm-judge-check
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-only
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-only
LANGFUSE_INIT_USER_EMAIL=local@llm-judge-check.test
LANGFUSE_INIT_USER_NAME=local
LANGFUSE_INIT_USER_PASSWORD=local-only-password
