# Test-only accounts on the local qa-practice-api server that src/run.js starts.
# Leave unset to use the built-in throwaway defaults (see src/run.js).
# Admin the server is seeded with (also passed to k6 as __ENV.ADMIN_*).
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=your-test-admin-password
# Password for the users the k6 scripts register.
K6_USER_PASSWORD=your-test-user-password
